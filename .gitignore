# Secrets and runtime config
.env
daemon.toml

# SQLite state and write-ahead log
state.db
state.db-journal
state.db-wal
state.db-shm

# Runtime working dirs (per-worker scratch, queued attachments, logs)
logs/
workers/
inbox/

# Per-user project registrations are personal (they reference paths
# specific to your machine). Ship the directory empty via .gitkeep.
projects/*.yaml
!projects/.gitkeep

# OM's working dir: keep CLAUDE.md.template (source of truth), drop
# the rendered CLAUDE.md (generated by the daemon at startup) and
# other runtime artifacts.
om-workspace/CLAUDE.md
om-workspace/session.json
om-workspace/notes/
om-workspace/*.png
om-workspace/om_mcp.json

# Python build / virtualenv / cache
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Editors
.vscode/
.idea/
*.swp
*.swo

# Backups
*.bak
*.orig
