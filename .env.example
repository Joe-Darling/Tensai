# Copy to .env. Never commit.
#
# DO NOT set ANTHROPIC_API_KEY here — it would silently bill your API
# account instead of your Max subscription. The daemon checks for this
# on startup and refuses to run if it is set.

# Required: token for the Discord bot the orchestrator speaks as.
DISCORD_TOKEN=your-discord-bot-token-here

# Optional: a second Discord bot token used for system-generated
# messages (worker spawn acks, completions, scheduling notices). If
# unset, the daemon falls back to single-bot mode where the OM bot
# handles everything.
# DAEMON_DISCORD_TOKEN=your-second-discord-bot-token-here
